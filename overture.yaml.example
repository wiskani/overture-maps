# Overture Maps library configuration.
# Copy this file to overture.yaml (gitignored) and fill in your values.
# All fields can be overridden with environment variables:
#   OVERTURE_CITY, OVERTURE_BBOX_MIN_LON, OVERTURE_BBOX_MIN_LAT,
#   OVERTURE_BBOX_MAX_LON, OVERTURE_BBOX_MAX_LAT,
#   OVERTURE_DATA_RELEASE, OVERTURE_SCHEMA_VERSION,
#   OVERTURE_DB_URL, OVERTURE_DB_SYNC_URL, OVERTURE_DATA_DIR
#
# When using this library as a dependency in another application, do NOT copy
# this file into that project. Instead, generate overture.yaml from your
# application settings (e.g. via a geo:init command) or set env vars directly.

city: your-city

bbox:
  min_lon: 0.0
  min_lat: 0.0
  max_lon: 0.0
  max_lat: 0.0

# Overture Maps release tag. Find available releases at:
# https://github.com/OvertureMaps/data/blob/main/README.md
data_release: "2024-11-13.0"

# NOTE: schema_version is NOT embedded in the GeoParquet file metadata.
# The 'version' field in GeoParquet metadata refers to the GeoParquet
# specification version (e.g. 1.1.0), not the Overture Maps schema version.
# Declare the Overture schema version manually here.
schema_version: "1.0.0"

themes:
  - addresses
  - places
  - divisions
  - transportation

# Database connection URLs for the CLI commands.
# When using this library programmatically, pass Config directly instead.
db_url: "postgresql+asyncpg://user:password@host:port/dbname"
db_sync_url: "postgresql://user:password@host:port/dbname"

# Directory where GeoParquet files are stored after downloading with overturemaps CLI.
# Resolution priority: OVERTURE_DATA_DIR env var > this field > ~/.local/share/overture-maps/
# Leave commented to use the default XDG user data directory.
# data_dir: /path/to/your/overture-data
